# test.rafimda.com.tr server { } bloğuna eklenecek parçalar (nginx.conf.example'ı tamamlar, yerine geçmez).

# 0) deploy/ dizini web'den ASLA sunulmamalı (FriSay'ın kendi engel listesinde yok; test/araç dosyaları içerir).
#    Canlı sunucuda da ekleyin.
location ^~ /deploy/ {
    deny all;
}

# 1) Her yanıta arama motoru engeli
#    UYARI: nginx'te bir location kendi add_header'ını tanımlarsa üst seviyedekiler o location'a MİRAS KALMAZ.
#    Bu yüzden ek location açarsanız (ör. statik dosya önbelleği) X-Robots-Tag'i orada da tekrarlayın veya
#    conf/staging_guard.php (auto_prepend_file) kullanın: PHP yanıtlarına başlığı her durumda ekler.
add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;

# 2) robots.txt her zaman tam engel (FriSay'ın kökteki robots.txt dosyasına dokunmadan)
location = /robots.txt {
    default_type text/plain;
    return 200 "User-agent: *\nDisallow: /\n";
}

# 3) Önerilen: staging'i HTTP Basic Auth arkasına al (parola dosyası repoda TUTULMAZ)
#    sudo htpasswd -c /etc/nginx/.htpasswd-rafimda-staging KULLANICI
auth_basic           "Rafimda Staging";
auth_basic_user_file /etc/nginx/.htpasswd-rafimda-staging;

# 4) Erişim ve hata logları (canlıdan ayrı dosyalar)
access_log /var/log/nginx/rafimda-staging.access.log;
error_log  /var/log/nginx/rafimda-staging.error.log warn;

# 5) Cron uçları Basic Auth'u atlayabilir (anahtar `key=` zorunlu kalır). `location /` bloğunuzdaki try_files satırının AYNISINI kullanın;
#    FriSay yönlendirmesinin nginx'te nasıl çalıştığı bu pakette doğrulanmadı:
#    location ~ ^/(xml-cron|pazaryeri-cron)$ { auth_basic off; try_files $uri $uri/ /index.php?$query_string; }
#    Basic Auth'u muaf tutmak yerine cron curl'üne `-u KULLANICI:PAROLA` vermek daha güvenlidir.

# 6) E-posta: staging'in gerçek e-posta göndermemesi için PHP-FPM havuzunda (php.ini değil, pool dosyası):
#    php_admin_value[sendmail_path] = /bin/true
#    FriSay MAIL_DRIVER=smtp ise SMTP ayarlarını staging'de BOŞ bırakın.
