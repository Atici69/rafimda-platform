# Staging ortam değişkenleri ÖRNEĞİ — gerçek değerleri BURAYA YAZMAYIN, bu dosyayı kopyalayıp sunucuda
# repo DIŞINDA (ör. /etc/rafimda/staging.env, izin 600) tutun ve: set -a; . /etc/rafimda/staging.env; set +a
RAFIMDA_ENV=staging
RAFIMDA_STAGING_CONFIRM=EVET-STAGING-DB
RAFIMDA_SITE_URL=https://test.rafimda.com.tr/
# Canlı veritabanının adı (yalnızca kıyaslama için: DB_NAME bununla aynıysa araçlar reddeder)
RAFIMDA_PROD_DB_NAME=CANLI_DB_ADI
DB_HOST=localhost
DB_NAME=rafimda_staging
DB_USER=rafimda_staging_user
DB_PASS=
# İsteğe bağlı: yönetim paneli yolu (boşsa rastgele üretilir)
RAFIMDA_ADMIN_URI=
