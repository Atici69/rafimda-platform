{assign var=mhStates value=['queued' => 'Kuyrukta', 'sending' => 'Gönderiliyor', 'ready' => 'Gönderime hazır', 'sent' => 'Onay bekliyor', 'live' => 'Yayında', 'failed' => 'Başarısız', 'blocked' => 'Engellendi']}
<div class="tbl-wrap"><table class="tbl"><thead><tr><th>Ürün</th><th>Pazaryeri</th><th>Durum</th><th>Deneme</th><th>Not</th></tr></thead><tbody>
{foreach $listings as $l}<tr><td>#{$l.id_product|escape}</td><td>{$l.marketplace|escape}</td><td><span class="pill">{if isset($mhStates[$l.state])}{$mhStates[$l.state]|escape}{else}{$l.state|escape}{/if}</span></td><td>{$l.attempts|escape}</td><td>{$l.error|escape}{if !empty($l.preview)}<details><summary class="muted">Hazırlanan veri</summary><pre style="white-space:pre-wrap;max-height:240px;overflow:auto;font-size:11px">{$l.preview|escape}</pre></details>{/if}</td></tr>{foreachelse}<tr><td colspan="5" class="muted">Kayıt yok.</td></tr>{/foreach}
</tbody></table></div>
