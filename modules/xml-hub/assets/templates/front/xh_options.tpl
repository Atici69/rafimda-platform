{foreach ['create_new' => 'Yeni ürünleri ekle', 'update_existing' => 'Mevcut ürünleri güncelle', 'sync_price' => 'Fiyatı güncelle', 'sync_stock' => 'Stoğu güncelle', 'sync_description' => 'Açıklamayı güncelle', 'sync_images' => 'Görselleri senkronize et (aşağıdaki moda göre)', 'sync_cargo' => 'Kargo ücretini kaydet (xh_product_meta)', 'create_variants' => 'Mevcut ürüne yeni varyantları ekle', 'auto_category' => 'Kategorileri otomatik eşleştir (ad/yol benzerliği; emin olunamayanlar onaya düşer)', 'auto_brand' => 'Sitede olmayan markaları otomatik oluştur'] as $k => $l}
<label class="chk"><input type="hidden" name="opt[{$k|escape}]" value="0"><input type="checkbox" name="opt[{$k|escape}]" value="1"{if $opt[$k]} checked{/if}> {$l|escape}</label>
{/foreach}
<div class="grid g2">
	<div><label>Kâr oranı (%)</label><input type="number" step="0.01" name="opt[price_markup_percent]" value="{$opt.price_markup_percent|escape}"></div>
	<div><label>Kâr hesabı</label><select name="opt[profit_mode]"><option value="markup"{if $opt.profit_mode|default:'markup' != 'margin'} selected{/if}>Maliyet üzerine ekle (100 ₺ + %40 = 140 ₺)</option><option value="margin"{if $opt.profit_mode|default:'' == 'margin'} selected{/if}>Satış fiyatı içinden kâr (100 ₺, %40 marj = 166,67 ₺)</option></select></div>
	<div><label>Sabit ekleme (₺, KDV hariç)</label><input type="number" step="0.01" name="opt[price_add]" value="{$opt.price_add|escape}"></div>
	<div><label>XML fiyatı KDV</label><select name="opt[vat_mode]"><option value="none"{if $opt.vat_mode|default:'none' != 'add'} selected{/if}>KDV dahil geliyor (ekleme yapma)</option><option value="add"{if $opt.vat_mode|default:'' == 'add'} selected{/if}>KDV hariç geliyor: KDV ekle</option></select></div>
	<div><label>KDV oranı (%) — XML'de KDV alanı yoksa</label><input type="number" step="0.01" min="0" max="100" name="opt[vat_rate]" value="{$opt.vat_rate|default:20|escape}"></div>
	<div><label>Varsayılan kategori</label><select name="opt[default_category]"><option value="0">—</option>{foreach $categories as $c}<option value="{$c.id_category|escape}"{if $c.id_category == $opt.default_category} selected{/if}>{$c.category_name|escape}</option>{/foreach}</select></div>
	<div><label>Varsayılan marka</label><select name="opt[default_brand]"><option value="0">—</option>{foreach $brands as $b}<option value="{$b.id_brand|escape}"{if $b.id_brand == $opt.default_brand} selected{/if}>{$b.brand_name|escape}</option>{/foreach}</select></div>
	<div><label>Görsel modu</label><select name="opt[image_mode]"><option value="if_empty"{if $opt.image_mode != 'add_new'} selected{/if}>Yalnızca görseli olmayan ürüne ekle</option><option value="add_new"{if $opt.image_mode == 'add_new'} selected{/if}>Yeni görsel adreslerini ekle (eskiler silinmez)</option></select></div>
	<div><label>Ürün başına en çok görsel</label><input type="number" min="0" max="10" name="opt[max_images]" value="{$opt.max_images|escape}"></div>
</div>
<p class="muted" style="font-size:12px">Hesap sırası: tedarikçi fiyatı → kâr → sabit ekleme → KDV → kuruşa yuvarlama. Örnek (KDV hariç 100 ₺, %40 kâr, %20 KDV): maliyet üzerine ekle = 168,00 ₺; satış içinden marj = 200,00 ₺.</p>
